[Unit]
Description=BookingBot Web API (FastAPI)
After=network.target postgresql.service

[Service]
Type=exec
User=root
WorkingDirectory=/opt/booking_bot
# Секреты — только на сервере (EnvironmentFile или drop-in), не в репозитории.
Environment=DATABASE_URL=postgresql+asyncpg://bot_user:***REMOVED***@localhost/booking_bot
Environment=JWT_SECRET=***REMOVED***
ExecStart=/opt/booking_bot/venv/bin/uvicorn web.api.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

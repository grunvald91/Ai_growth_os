# Telegram bot
BOT_TOKEN=123456789:replace_with_your_bot_token
BOT_USERNAME=YourBookingBot

# Database type
DB_TYPE=postgresql

# PostgreSQL database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=booking_bot
DB_USER=postgres
DB_PASSWORD=replace_with_database_password

# Timezone
TIMEZONE=Europe/Moscow

# Admin user IDs (comma-separated)
ADMIN_IDS=123456789

# WebApp
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
WEBAPP_URL=https://your-domain.example

# MLM database
MLM_DB_HOST=localhost
MLM_DB_PORT=5432
MLM_DB_NAME=mlm_bot
MLM_DB_USER=postgres
MLM_DB_PASSWORD=replace_with_mlm_database_password

# MLM bot link
MLM_BOT_USERNAME=YourMlmBot

# PWA / Web Push (generate an ECDSA P-256 VAPID key pair; keep private key secret)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Business reminder timezone until per-business timezones are introduced
SERVGO_TIMEZONE=Europe/Moscow

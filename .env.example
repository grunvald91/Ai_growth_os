# Runtime
APP_ENV=development
DATABASE_URL=postgresql+psycopg://ai_growth:ai_growth@postgres:5432/ai_growth
SKILLS_ROOT=skills
PRODUCTS_ROOT=products

# Choose one LLM provider.
LLM_PROVIDER=xai
LLM_MODEL=grok-4.7

# Grok via ClaudeHub OpenAI-compatible gateway.
# Use the same sk-hub-... key that can also be used for Claude Code.
XAI_API_KEY=replace_me_locally
XAI_BASE_URL=https://api.claudehub.fun/v1
XAI_REASONING_EFFORT=medium

# Anthropic-compatible fallback
ANTHROPIC_API_KEY=replace_me_locally
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Never put real credentials in this file.

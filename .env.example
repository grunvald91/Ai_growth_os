# Runtime
APP_ENV=development
DATABASE_URL=postgresql+psycopg://ai_growth:ai_growth@postgres:5432/ai_growth
SKILLS_ROOT=skills
PRODUCTS_ROOT=products

# Choose one LLM provider.
LLM_PROVIDER=xai
LLM_MODEL=deepseek-v4.1-flash

# Cheap text models via ClaudeHub OpenAI-compatible gateway.
# Use the same sk-hub-... key that can also be used for Claude Code.
XAI_API_KEY=replace_me_locally
XAI_BASE_URL=https://api.claudehub.fun/v1
XAI_REASONING_EFFORT=low
LLM_FALLBACK_MODELS=gemini-flash-3.8
TEAM_LLM_FALLBACK_MODELS=grok-4.7

# Optional Jeff decision endpoint (OpenAI-compatible Chat Completions).
# When unset/unavailable, business intelligence escalates to the configured strong LLM.
JEFF_API_KEY=
JEFF_BASE_URL=
JEFF_MODEL=jeff
INTELLIGENCE_CONFIDENCE_THRESHOLD=0.8
INTELLIGENCE_CAMPAIGN_ENABLED=true
# Deterministic per-role model routing (opt-in).
# Confirm actual ClaudeHub model IDs before enabling. K3/Sonnet/Opus disabled by default.
# The router fails closed if premium tasks have no enabled premium model.
MODEL_ROUTER_ENABLED=false
# JSON model catalog & overrides can be supplied from the private .env or runtime.
# Example: [{"model":"kimi-k3","tier":"balanced","enabled":true}]
# MODEL_ROUTER_PROFILES=
# Example: {"company_intake":["kimi-k3"],"cmo":["claude-opus-5-5"]}
MODEL_ROUTER_OVERRIDES={}
# Optional ESTIMATED per-call USD ceiling; requires both prices for every candidate.
# MODEL_ROUTER_MAX_CALL_USD=0.10

# Optional manual Anthropic provider (never an automatic fallback)
ANTHROPIC_API_KEY=replace_me_locally
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Telegram control bot (optional)
TELEGRAM_BOT_TOKEN=replace_me_locally
TELEGRAM_OWNER_CHAT_ID=123456789
TELEGRAM_POLL_TIMEOUT_SECONDS=25

# Internal team worker
TEAM_LLM_MODEL=kimi-2.7
TEAM_LLM_FALLBACK_MODELS=grok-4.7
TEAM_XAI_REASONING_EFFORT=low
TEAM_WORKER_BATCH_SIZE=1
# One subordinate quality review and, only if needed, one author-owned correction.
# Opt in after testing LLM cost/latency; does not authorize publishing.
AGENT_CRITIC_ENABLED=false
TEAM_WORKER_IDLE_POLL_SECONDS=20
TEAM_WORKER_BUSY_POLL_SECONDS=2
TELEGRAM_PROXY_URL=
# YouTube, Telegram, Instagram and Threads use this confirmed foreign HTTP(S) proxy.
# Production defaults to the confirmed 188.120.254.223:8891 entrypoint, onward via 89…
# VK and VK Video always use direct requests. No implicit Telegram-proxy reuse.
COMMENT_PLATFORM_PROXY_URL=

# Pre-editorial live niche research. V1 uses public YouTube search/watch pages
# and treats views as a creative signal, never as proof of demand.
VIRAL_RESEARCH_MODE=youtube_public
VIRAL_RESEARCH_MAX_QUERIES=4
VIRAL_RESEARCH_MAX_CANDIDATES=16
VIRAL_RESEARCH_TIMEOUT_SECONDS=20

# Never put real credentials in this file.

# Production Studio/API protection: operator account and HTTPS origin.
STUDIO_ADMIN_USERNAME=
STUDIO_ADMIN_PASSWORD=
STUDIO_PUBLIC_ORIGIN=https://growth.servgo.ru
# Optional private JSON account file inside the persistent company_products volume.
STUDIO_USERS_FILE=
CONTENT_TELEGRAM_AUTOPOST_ENABLED=false
CONTENT_TELEGRAM_MAX_LATENESS_MINUTES=30
RELEASE_SHA=


# Existing Nginx APR1 credentials, mounted read-only in production.
STUDIO_HTPASSWD_FILE=
STUDIO_HTPASSWD_HOST_FILE=/etc/nginx/.htpasswd-growth-studio
# Owner-only dashboard: set a fresh random >=32-character token on API only.
# MODEL_ROUTER_ADMIN_TOKEN=replace-with-a-long-unique-random-secret

# Narrated whiteboard jobs: explicit owner confirmation and bounded API call count.
# This is separate from the shared marketing team model configuration.
OPENROUTER_API_KEY=
WHITEBOARD_STORYBOARD_MODEL=kimi-2.7
# Used in this order when the model above gets no answer from ClaudeHub (5xx, 429, no connection).
WHITEBOARD_STORYBOARD_FALLBACK_MODELS=kimi-k3,grok-4.7,claude-sonnet-5-5
WHITEBOARD_IMAGE_MODEL=google/gemini-3.1-flash-image
WHITEBOARD_SPEECH_MODEL=google/gemini-3.8-flash-lite-tts
WHITEBOARD_REGIONS_MODEL=google/gemini-3.1-flash-lite
WHITEBOARD_VOICE=Kore
# Automatic continuations after transient failures (0-5, 0 disables); spends only approved calls.
WHITEBOARD_AUTO_RESUME_ATTEMPTS=5
# Optional explicitly configured existing trusted HTTP(S) proxy; HTTPS verification stays on.
WHITEBOARD_PROXY_URL=

# Company intake: optional registry check by ИНН/ОГРН (DaData, free tier is enough).
# Without it the owner's ИНН is kept as text and marked as not verified.
DADATA_API_KEY=
